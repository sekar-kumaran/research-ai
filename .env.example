# ════════════════════════════════════════════════════════════════════════════
#  Research AI Intelligence Platform v3.1 — Environment Configuration
#  Copy this file to .env for local development.
#  On Hugging Face Spaces: add these as Repository Secrets (not in .env).
# ════════════════════════════════════════════════════════════════════════════

# ── LLM Backend ──────────────────────────────────────────────────────────────
# "cloud"  → use a hosted API (recommended for HF Spaces — no GPU needed)
# "local"  → use local HuggingFace models (requires GPU or patience)
LLM_BACKEND=cloud

# ── Cloud LLM Provider ────────────────────────────────────────────────────────
# Options: gemini | groq | openrouter | google | ollama
# "gemini" is recommended for Hugging Face deployment (free tier available)
CLOUD_LLM_PROVIDER=gemini

# ── Google Gemini (recommended for Hugging Face deployment) ──────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# On HF Spaces: Settings → Repository secrets → New secret → GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
# Model options:
#   gemini-3.5-flash          ← recommended (default, current)
#   gemini-2.0-flash          ← fallback
#   gemini-1.5-flash          ← older fallback
#   gemini-1.5-pro            ← more capable, higher quota usage
GEMINI_MODEL=gemini-3.5-flash

# ── Groq (alternative — very fast, free tier available) ──────────────────────
# CLOUD_LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# Faster/lighter alternative:
# GROQ_MODEL=llama-3.1-8b-instant

# ── OpenRouter (alternative free tier) ───────────────────────────────────────
# CLOUD_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Google Gemini (legacy env var names — still work, GEMINI_* takes precedence)
# GOOGLE_API_KEY=your_key_here
# GOOGLE_MODEL=gemini-2.0-flash

# ── Ollama (local, no API key needed — for local dev only) ───────────────────
# CLOUD_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_ROOT=data
ARTIFACTS_ROOT=artifacts

# ── Retrieval ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Security ─────────────────────────────────────────────────────────────────
# Disable sandboxed Python execution for public deployments
ENABLE_PYTHON_EXECUTION=false

# ── Server ───────────────────────────────────────────────────────────────────
# HF Spaces uses port 7860; local dev can use 8000
PORT=7860
HOST=0.0.0.0
# Restrict CORS in production. Use * only for local dev.
# ALLOWED_ORIGINS=https://your-space.hf.space,https://your-domain.com

# ── Hugging Face Artifact Download (optional) ────────────────────────────────
# If large artifacts (classifier.joblib) are hosted on a HF Dataset repo,
# set this to auto-download them at startup when missing locally.
# HF_ARTIFACTS_REPO=sekar-kumaran/research-ai-artifacts
