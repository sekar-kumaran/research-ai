# ════════════════════════════════════════════════════════════════════════════
#  Research AI Intelligence Platform v3.1 — Environment Configuration
#  Copy this file to .env for local development.
#  On Hugging Face Spaces: add these as Repository Secrets (not in .env).
# ════════════════════════════════════════════════════════════════════════════
# ════════════════════════════════════════════════════════════════════════════
#  Research AI Intelligence Platform v3.1 — Environment Configuration
#  Copy this file to .env for local development.
#  On Hugging Face Spaces: add these as Repository Secrets (not in .env).
# ════════════════════════════════════════════════════════════════════════════

# ── LLM Backend ──────────────────────────────────────────────────────────────
# "cloud"  → use a hosted API (recommended for HF Spaces — no GPU needed)
# "local"  → use local HuggingFace models (requires GPU or patience)
LLM_BACKEND=cloud

# ── Cloud LLM Provider ────────────────────────────────────────────────────────
# Options: omnirouter | ollama | gemini | groq | openrouter | google
# OmniRouter is the recommended provider — routes to 497 models, no rate limits.
CLOUD_LLM_PROVIDER=omnirouter

# ── OmniRouter (RECOMMENDED — local proxy, no rate limits, 497+ models) ──────
# OmniRouter is a local OpenAI-compatible proxy that routes to Gemini, Claude,
# GPT, and many other providers automatically using smart routing.
# Install: https://github.com/OmniRouter/OmniRouter
OMNIROUTER_BASE_URL=http://localhost:20218/v1
OMNIROUTER_API_KEY=your-omnirouter-api-key-here
# Smart auto-routing model IDs — OmniRouter picks the best available model:
PRIMARY_MODEL=auto/best-chat
REASONING_MODEL=auto/best-reasoning
FAST_MODEL=auto/fast
TECHNICAL_MODEL=auto/best-coding
FALLBACK_MODELS=auto/best-free

# ── Google Gemini (alternative for HF deployment) ────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# On HF Spaces: Settings → Repository secrets → New secret → GEMINI_API_KEY
GEMINI_API_KEY=
# Model options:
#   gemini-3.5-flash          <- recommended (default, current)
#   gemini-2.0-flash          <- fallback
#   gemini-1.5-flash          <- older fallback
#   gemini-1.5-pro            <- more capable, higher quota usage
GEMINI_MODEL=gemini-3.5-flash

# ── Groq (alternative — very fast, free tier available) ──────────────────────
# CLOUD_LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# Faster/lighter alternative:
# GROQ_MODEL=llama-3.1-8b-instant

# ── OpenRouter (alternative free tier) ───────────────────────────────────────
# CLOUD_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Google Gemini (legacy env var names — still work, GEMINI_* takes precedence)
# GOOGLE_API_KEY=your_key_here
# GOOGLE_MODEL=gemini-2.0-flash

# ── Ollama (local, no API key needed — for local dev only) ───────────────────
# CLOUD_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=
# PRIMARY_MODEL=llama3.1:8b
# REASONING_MODEL=llama3.1:8b
# FAST_MODEL=llama3.1:8b

TECHNICAL_MODEL=qwen3-coder:480b-cloud
FALLBACK_MODELS=gpt-oss:20b-cloud

# ── Retrieval ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
PAPER_SEARCH_PROVIDER=auto
ARXIV_ENABLED=true
CROSSREF_ENABLED=true
OPENALEX_ENABLED=true
MAX_RETRIEVAL_RESULTS=20
TOP_K=5
REQUEST_TIMEOUT=30
MODEL_TIMEOUT=120

# ── Security ─────────────────────────────────────────────────────────────────
# Disable sandboxed Python execution for public deployments
ENABLE_PYTHON_EXECUTION=false

# ── Server ───────────────────────────────────────────────────────────────────
# HF Spaces uses port 7860; local dev can use 8000
PORT=7860
HOST=0.0.0.0
# Restrict CORS in production. Use * only for local dev.
# ALLOWED_ORIGINS=https://your-space.hf.space,https://your-domain.com

# ── Hugging Face Artifact Download (optional) ────────────────────────────────
# If large artifacts (classifier.joblib) are hosted on a HF Dataset repo,
# set this to auto-download them at startup when missing locally.
# HF_ARTIFACTS_REPO=sekar-kumaran/research-ai-artifacts


# Local Docker rebuild defaults
# These override the legacy Hugging Face Spaces-oriented settings above.
CLOUD_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:8b
DATABASE_URL=postgresql+psycopg://researchai:researchai@postgres:5432/researchai
POSTGRES_DB=researchai
POSTGRES_USER=researchai
POSTGRES_PASSWORD=researchai
SECRET_KEY=change-me-local-dev-secret
